<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Resolved via NuGet rather than a machine-pinned shared-runtime DLL path
         (previously hard-coded to AspNetCore 9.0.11) so the suite builds on any
         machine with the net9.0 SDK. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- OrderService.CreateOrderAsync catches DbUpdateConcurrencyException, so the
         EF Core assembly must be loadable at runtime for tests that exercise it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TBM.Application">
      <HintPath>..\..\src\TBM.Application\bin\$(Configuration)\net9.0\TBM.Application.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TBM.Core">
      <HintPath>..\..\src\TBM.Core\bin\$(Configuration)\net9.0\TBM.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
